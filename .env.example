# ============================================================
# Gemini SmartNotes - Environment Configuration
# ============================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Get a free Google Gemini API Key from:
#    https://aistudio.google.com/app/apikey
# 3. Paste your key below. Never commit your actual '.env' file!
# ============================================================

# Google Gemini API Key (Required for live AI generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini Model (Optional, defaults to auto-select gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# Mock / Simulation Mode (true / false)
# Set to 'false' for live Gemini API calls. If API key is empty, simulation mode activates automatically.
MOCK_MODE=false

# Server Configuration
PORT=8000
HOST=0.0.0.0
